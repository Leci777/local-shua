{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:57821",
  "PcVideo": {
    "ServerName": "我的电脑",
    "DataDir": "",
    "Pairing": {
      "CodeLength": 6,
      "CodeTtlSeconds": 300
    },
    "Scan": {
      "Extensions": [ ".mp4", ".mkv", ".flv", ".avi", ".ts", ".wmv", ".mov", ".rmvb", ".webm", ".m4v", ".mpg", ".mpeg", ".3gp" ],
      "Concurrency": 4,
      "FfprobeTimeoutSeconds": 15
    },
    "Discovery": {
      "UdpPort": 57822
    },
    "Random": {
      "MaxExcludeIds": 50,
      "DefaultLimit": 20
    }
  }
}

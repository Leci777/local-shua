<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinForms 托盘要求目标平台带 -windows -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PcVideo.Server</RootNamespace>
    <AssemblyName>PcVideo.Server</AssemblyName>
    <!-- WinExe：双击启动不弹黑控制台窗口；日志走 Serilog 文件 -->
    <OutputType>WinExe</OutputType>
    <!-- 托盘 NotifyIcon 需要 WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- EF 迁移设计时用，不随发布输出 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ffprobe zip 存在才编入（仓库不放大文件，见 tools/ffprobe/README.md）。
       注意路径相对项目目录解析：zip 在解决方案级 server/tools/，要写 ../ -->
  <ItemGroup Condition="Exists('../tools/ffprobe/ffprobe-win-x64.zip')">
    <EmbeddedResource Include="../tools/ffprobe/ffprobe-win-x64.zip" LogicalName="ffprobe-win-x64.zip" />
  </ItemGroup>

</Project>
